PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/smooth

# Auth
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d

# File uploads
MAX_FILE_SIZE_MB=10

# Cloudinary (image/video hosting) - set when cloud storage is implemented
CLOUDINARY_URL=

# Payments (MTN / Orange) - placeholders for gateway integration (BE-11)
MTN_API_BASE=
MTN_API_KEY=
ORANGE_API_BASE=
ORANGE_API_KEY=
